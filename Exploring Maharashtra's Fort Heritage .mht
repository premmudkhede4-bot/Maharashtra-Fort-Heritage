.section-head p { font: 14px / 1.8 "Plus Jakarta Sans", Arial, sans-serif; color: rgb(174, 181, 193); }

.kicker { color: rgb(197, 160, 89); font-weight: 600; }

#about, .timeline, .photo-gallery { background: rgb(12, 14, 18); color: rgb(216, 221, 230); }

.intro-grid { gap: 42px; }

.quote { background: linear-gradient(140deg, rgb(27, 32, 43), rgb(20, 23, 31)); border: 1px solid var(--fv-border); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.35) 0px 16px 40px; }

.quote p { font: 500 19px / 1.65 Cinzel, Georgia, serif; color: rgb(247, 248, 250); }

.quote small { color: rgb(197, 160, 89); }

.forts, .photo-gallery { background: rgb(20, 23, 31); color: rgb(216, 221, 230); }

.cards { gap: 22px; }

.fort-card, .fort-photo-card, .knowledge-card, .panel, .px-panel, .px-feature-card { background: rgb(20, 23, 31); color: rgb(216, 221, 230); border: 1px solid var(--fv-border); border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.32) 0px 8px 24px; overflow: hidden; }

.fort-card:hover, .fort-photo-card:hover, .knowledge-card:hover { border-color: rgba(230, 197, 117, 0.65); box-shadow: rgba(197, 160, 89, 0.14) 0px 0px 25px, rgba(0, 0, 0, 0.4) 0px 12px 30px; }

.fort-body h3, .knowledge-card h3, .era h3, .panel h3 { color: rgb(247, 248, 250); font-family: Cinzel, Georgia, serif; }

.fort-body p, .knowledge-card p, .era p, .panel p, .panel li { color: rgb(174, 181, 193); }

.place { color: rgb(197, 160, 89); }

.more, .photo-credit a, .fort-photo-card figcaption a { color: rgb(230, 197, 117); }

.toolbar input, .toolbar select, .px-field input, .px-field select, .px-field textarea, input, select, textarea { background: rgb(27, 32, 43); color: rgb(247, 248, 250); border: 1px solid rgba(197, 160, 89, 0.28); border-radius: 6px; }

.toolbar input::placeholder, input::placeholder, textarea::placeholder { color: rgb(139, 146, 160); }

.knowledge { background: rgb(17, 21, 28); color: rgb(216, 221, 230); }

.knowledge-card { border-top: 3px solid rgb(197, 160, 89); }

.knowledge-card .symbol { color: rgb(230, 197, 117); }

.timeline { background: rgb(12, 14, 18); }

.era { border-color: rgba(197, 160, 89, 0.25); }

.era::before { background: rgb(197, 160, 89); }

.era strong { color: rgb(230, 197, 117); }

.explore { background: rgb(20, 23, 31); color: rgb(216, 221, 230); border-top: 1px solid var(--fv-border); border-bottom: 1px solid var(--fv-border); }

.explore .section-head p { color: rgb(174, 181, 193); }

.panel { background: rgb(27, 32, 43); border-radius: 10px; }

.panel h3, .quiz-result { color: rgb(230, 197, 117); }

.quiz-options button { border-radius: 6px; border-color: rgba(197, 160, 89, 0.35); background: rgb(20, 23, 31); }

.quiz-options button:hover { border-color: rgb(230, 197, 117); background: rgb(36, 42, 54); }

footer { background: rgb(8, 10, 14); color: rgb(194, 199, 208); border-top: 1px solid var(--fv-border); font-family: "Plus Jakarta Sans", Arial, sans-serif; }

footer strong { color: rgb(197, 160, 89); }

.modal { background: rgba(4, 6, 9, 0.88); backdrop-filter: blur(7px); }

.modal-box { background: rgb(20, 23, 31); color: rgb(216, 221, 230); border: 1px solid var(--fv-border); border-radius: 12px; }

.modal-box h2, .modal-box h4 { color: rgb(230, 197, 117); }

.modal-box p, .modal-box li { color: rgb(194, 199, 208); }

.fort-photo-card figcaption strong { color: rgb(247, 248, 250); }

.fort-photo-card figcaption span, .fort-photo-card figcaption small, .gallery-note { color: rgb(174, 181, 193); }

.px-section { color: rgb(216, 221, 230); background: rgb(12, 14, 18) !important; }

.px-section:nth-of-type(2n) { background: rgb(20, 23, 31) !important; }

.px-heading h2, .px-panel h3, .px-feature-card h3 { color: rgb(247, 248, 250); }

.px-heading p, .px-muted, .px-panel p { color: rgb(174, 181, 193); }

.px-panel, .px-feature-card { background: rgb(20, 23, 31); border-color: var(--fv-border); border-radius: 10px; }

#fortMap { border: 1px solid var(--fv-border); border-radius: 10px; }

