  .quote p { font-size: 19px; }
}

.fort-art img { width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; }

.photo-gallery { background: var(--paper,#f4f0e7); }

.fort-photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 18px; }

.fort-photo-card { margin: 0px; background: var(--bg,#fff); border: 1px solid rgba(90, 75, 48, 0.16); overflow: hidden; box-shadow: rgba(30, 25, 16, 0.07) 0px 8px 24px; }

.fort-photo-link { display: block; overflow: hidden; background: transparent; min-height: 0px; }

.fort-photo-card img { display: block; width: 100%; height: 230px; object-fit: cover; transition: transform 0.5s; background: transparent; }

.fort-photo-card:hover img { transform: scale(1.045); }

.fort-photo-card figcaption { padding: 14px 16px 16px; display: grid; gap: 6px; }

.fort-photo-card figcaption strong { font: 600 15px / 1.3 Arial, sans-serif; color: var(--ink,#27342c); }

.fort-photo-card figcaption span { font: 13px / 1.5 Arial, sans-serif; color: var(--muted,#68766d); }

.fort-photo-card figcaption small { font: 10px / 1.5 Arial, sans-serif; color: rgb(138, 128, 109); }

.fort-photo-card figcaption a { color: rgb(138, 104, 43); }

.gallery-note { font: 11px / 1.6 Arial, sans-serif; color: var(--muted,#68766d); margin-top: 20px; }

@media (max-width: 900px) {
  .fort-photo-grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  .fort-photo-card img { height: 210px; }
}

@media (max-width: 560px) {
  .fort-photo-grid { grid-template-columns: 1fr; }
  .fort-photo-card img { height: 230px; }
}

:root { --ink: #172b25; --green: #24483a; --leaf: #66866a; --gold: #c5a059; --sand: #f4efe3; --paper: #fffdf7; --muted: #68766d; --line: #e5dece; --fv-bg: #0c0e12; --fv-surface: #14171f; --fv-elevated: #1b202b; --fv-white: #f7f8fa; --fv-muted: #8b92a0; --fv-gold: #c5a059; --fv-border: rgba(197,160,89,.22); }

