.navlinks { display: flex; align-items: center; gap: 18px; flex-wrap: nowrap; }

.navlinks a, .px-nav-addon a { color: rgb(216, 221, 230); text-decoration: none; font: 600 10px "Plus Jakarta Sans", Arial, sans-serif; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }

.navlinks a:hover, .px-nav-addon a:hover { color: rgb(230, 197, 117); }

.px-nav-addon { display: flex; gap: 12px; align-items: center; }

.px-tools { gap: 7px; }

