@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap");

:root { --ink: #172b25; --green: #24483a; --leaf: #66866a; --gold: #d7a94b; --sand: #f4efe3; --paper: #fffdf7; --muted: #68766d; --line: #e5dece; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--sand); color: var(--ink); font-family: Georgia, "Times New Roman", serif; }

button, input { font: inherit; }

.sans { font-family: Arial, Helvetica, sans-serif; }

nav { height: 72px; padding: 0px 7%; display: flex; align-items: center; justify-content: space-between; background: rgb(23, 43, 37); color: rgb(255, 255, 255); position: sticky; top: 0px; z-index: 10; border-bottom: 1px solid rgba(255, 255, 255, 0.133); }

.brand { font: bold 17px Arial; letter-spacing: 0.3px; display: flex; align-items: center; gap: 10px; }

.brand-mark { width: 34px; height: 34px; border: 1px solid var(--gold); border-radius: 50%; display: grid; place-items: center; color: var(--gold); font-size: 20px; }

.navlinks { display: flex; gap: 25px; }

.navlinks a { color: rgb(233, 228, 216); text-decoration: none; font: 13px Arial; }

.navlinks a:hover { color: var(--gold); }

.hero { min-height: 650px; padding: 95px 8% 85px; color: white; position: relative; overflow: hidden; background-image: linear-gradient(90deg, rgba(10, 29, 23, 0.94) 0%, rgba(10, 29, 23, 0.82) 46%, rgba(10, 29, 23, 0.38) 100%), url("data:image/jpeg;base64,"); background-size: cover; background-position: center 48%; background-repeat: no-repeat; }

.hero::after { content: ""; position: absolute; right: -5%; bottom: -150px; width: 65%; height: 470px; border: 2px solid rgba(215, 169, 75, 0.333); border-radius: 50% 50% 0px 0px; transform: rotate(-8deg); box-shadow: rgba(215, 169, 75, 0.05) 0px 0px 0px 30px, rgba(215, 169, 75, 0.04) 0px 0px 0px 65px; }

.hero-inner { max-width: 780px; position: relative; z-index: 1; }

.eyebrow { font: 12px Arial; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin-bottom: 22px; }

.hero h1 { font-size: clamp(42px, 6vw, 76px); line-height: 1.02; margin: 0px 0px 25px; font-weight: normal; }

.hero h1 span { color: rgb(229, 189, 106); font-style: italic; }

.hero p { font: 17px / 1.75 Arial; max-width: 650px; color: rgb(225, 230, 223); }

.actions { display: flex; gap: 13px; margin-top: 32px; flex-wrap: wrap; }

.btn { border: 1px solid var(--gold); padding: 14px 22px; text-decoration: none; font: bold 13px Arial; letter-spacing: 0.5px; background: var(--gold); color: rgb(29, 48, 40); border-radius: 2px; }

.btn.outline { background: transparent; color: white; border-color: rgba(255, 255, 255, 0.533); }

.stats { display: flex; gap: 45px; margin-top: 55px; flex-wrap: wrap; }

.stat strong { display: block; font-size: 27px; color: var(--gold); font-weight: normal; }

.stat small { font: 11px Arial; letter-spacing: 1px; color: rgb(211, 219, 211); text-transform: uppercase; }

section { padding: 82px 8%; }

.section-head { max-width: 720px; margin-bottom: 34px; }

.kicker { font: 11px Arial; letter-spacing: 2.5px; text-transform: uppercase; color: rgb(155, 116, 45); }

.section-head h2 { font-size: clamp(30px, 4vw, 45px); font-weight: normal; margin: 10px 0px 12px; }

.section-head p { font: 15px / 1.7 Arial; color: var(--muted); margin: 0px; }

.intro-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 55px; align-items: center; }

.quote { background: var(--green); color: rgb(255, 255, 255); padding: 34px 36px; position: relative; }

.quote::before { content: "â€œ"; font-size: 75px; color: var(--gold); line-height: 0.7; }

.quote p { font-size: 22px; line-height: 1.5; margin: 12px 0px 18px; }

.quote small { font: 11px Arial; letter-spacing: 1px; color: rgb(217, 193, 141); }

.forts { background: var(--paper); }

.toolbar { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin: 25px 0px; }

.toolbar input, .toolbar select { background: white; border: 1px solid var(--line); padding: 12px 14px; border-radius: 3px; color: var(--ink); font: 14px Arial; }

.toolbar input { flex: 1 1 0%; min-width: 210px; }

.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

.fort-card { background: rgb(255, 255, 255); border: 1px solid var(--line); transition: 0.2s; cursor: pointer; }

.fort-card:hover { transform: translateY(-4px); box-shadow: rgba(23, 43, 37, 0.07) 0px 12px 30px; }

.fort-art { height: clamp(190px, 28vw, 270px); position: relative; overflow: hidden; background: linear-gradient(145deg, rgb(83, 109, 88), rgb(35, 62, 53)); display: flex; align-items: end; padding: 18px; color: rgb(255, 255, 255); }

.fort-art img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; max-width: none; border: 0px; margin: 0px; padding: 0px; vertical-align: middle; }

.fort-art::after { content: ""; position: absolute; inset: 35% 0px 0px; background: linear-gradient(0deg, rgba(16, 30, 25, 0.72), transparent); }

.fort-art::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(0deg, rgba(16, 30, 25, 0.2), transparent 75%); z-index: 1; }

.fort-art svg { display: none; }

.fort-art span { position: relative; z-index: 2; font: 11px Arial; letter-spacing: 1.5px; text-transform: uppercase; color: rgb(242, 209, 140); }

.fort-body { padding: 21px; }

.fort-body h3 { font-size: 24px; font-weight: normal; margin: 0px 0px 7px; }

.place { font: 12px Arial; color: rgb(139, 118, 80); margin-bottom: 13px; }

.fort-body p { font: 13px / 1.65 Arial; color: var(--muted); margin: 0px 0px 17px; }

.tags { display: flex; gap: 6px; flex-wrap: wrap; }

.tag { background: rgb(242, 238, 228); color: rgb(93, 104, 79); padding: 6px 8px; font: 10px Arial; border-radius: 2px; }

.more { display: inline-block; margin-top: 17px; color: rgb(147, 109, 41); font: bold 12px Arial; text-decoration: none; }

.knowledge { background: rgb(233, 228, 214); }

.knowledge-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }

.knowledge-card { background: var(--paper); padding: 0px 0px 25px; border-top: 3px solid var(--gold); overflow: hidden; }

.knowledge-photo { display: block; width: 100%; height: 165px; object-fit: cover; }

.photo-credit { display: block; padding: 7px 21px 0px; font: 10px / 1.4 Arial; color: rgb(138, 128, 109); }

.photo-credit a { color: rgb(138, 104, 43); text-decoration: underline; }

.knowledge-card .symbol, .knowledge-card h3, .knowledge-card p { margin-left: 21px; margin-right: 21px; }

.knowledge-card .symbol { font-size: 28px; margin-top: 17px; }

.knowledge-card h3 { font-size: 20px; font-weight: normal; margin-top: 12px; margin-bottom: 9px; }

.knowledge-card p { font: 13px / 1.7 Arial; color: var(--muted); margin-top: 0px; margin-bottom: 0px; }

@media (max-width: 760px) {
  .knowledge-grid { grid-template-columns: 1fr; gap: 15px; }
  .knowledge-photo { height: 190px; }
  .knowledge-card { padding-bottom: 22px; }
  .knowledge-card .symbol { margin-top: 14px; }
}

.timeline { background: var(--paper); }

.timeline-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0px; }

.era { padding: 22px; border-top: 1px solid rgb(205, 189, 154); position: relative; }

.era::before { content: ""; position: absolute; top: -6px; left: 22px; width: 11px; height: 11px; border-radius: 50%; background: var(--gold); }

.era strong { font: 12px Arial; color: rgb(155, 116, 45); }

.era h3 { font-size: 20px; font-weight: normal; margin: 12px 0px 8px; }

.era p { font: 13px / 1.6 Arial; color: var(--muted); }

.explore { background: rgb(29, 56, 46); color: white; }

.explore .section-head p { color: rgb(199, 208, 200); }

.explore-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; }

.panel { border: 1px solid rgba(255, 255, 255, 0.165); padding: 28px; background: rgba(255, 255, 255, 0.03); }

.panel h3 { font-size: 23px; font-weight: normal; margin: 0px 0px 14px; color: rgb(240, 209, 141); }

.panel p, .panel li { font: 13px / 1.75 Arial; color: rgb(214, 223, 215); }

.panel ul { padding-left: 19px; }

.quiz-options { display: grid; gap: 9px; margin-top: 15px; }

.quiz-options button { background: transparent; border: 1px solid rgba(255, 255, 255, 0.333); color: white; text-align: left; padding: 12px; font: 13px Arial; cursor: pointer; }

.quiz-options button:hover { border-color: var(--gold); background: rgba(255, 255, 255, 0.063); }

.quiz-result { margin-top: 13px; color: rgb(240, 209, 141); font: 13px Arial; min-height: 18px; }

footer { background: rgb(18, 35, 29); color: rgb(216, 223, 216); padding: 34px 8%; display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; font: 12px Arial; }

footer strong { color: var(--gold); }

.footnote { color: rgb(170, 184, 173); }

.modal { display: none; position: fixed; inset: 0px; background: rgba(7, 20, 15, 0.79); z-index: 30; align-items: center; justify-content: center; padding: 20px; }

.modal.show { display: flex; }

.modal-box { background: var(--paper); max-width: 620px; width: 100%; padding: 32px; position: relative; max-height: 85vh; overflow: auto; }

.close { position: absolute; right: 18px; top: 12px; border: 0px; background: none; font-size: 27px; cursor: pointer; color: var(--ink); }

.modal-box h2 { font-size: 32px; font-weight: normal; margin: 0px 35px 8px 0px; }

.modal-box p, .modal-box li { font: 14px / 1.7 Arial; color: rgb(88, 102, 92); }

.modal-box h4 { font: 12px Arial; text-transform: uppercase; letter-spacing: 1px; color: rgb(152, 112, 44); margin: 22px 0px 5px; }

@media (max-width: 850px) {
  .cards { grid-template-columns: repeat(2, 1fr); }
  .knowledge-grid { grid-template-columns: repeat(2, 1fr); }
  .intro-grid, .explore-grid { grid-template-columns: 1fr; }
  .timeline-list { grid-template-columns: repeat(2, 1fr); }
  .navlinks { gap: 12px; }
  .navlinks a { font-size: 11px; }
}

@media (max-width: 560px) {
  nav { padding: 0px 5%; height: 62px; }
  .navlinks { display: none; }
  .hero { padding: 72px 7% 65px; min-height: 690px; background-position: 58% center; background-image: linear-gradient(rgba(10, 29, 23, 0.55) 0%, rgba(10, 29, 23, 0.82) 36%, rgba(10, 29, 23, 0.97) 100%), url("data:image/jpeg;base64,"); }
  .hero p { font-size: 15px; }
  .stats { gap: 24px; }
  section { padding: 62px 7%; }
  .cards, .knowledge-grid, .timeline-list { grid-template-columns: 1fr; }
  .fort-art { height: clamp(190px, 56vw, 250px); }
