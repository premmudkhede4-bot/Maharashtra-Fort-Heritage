.hero { min-height: calc(-76px + 100svh); padding: 125px 8% 76px; display: flex; align-items: center; background-image: linear-gradient(rgba(12, 14, 18, 0.48), rgba(12, 14, 18, 0.84) 72%, rgb(12, 14, 18)), linear-gradient(90deg, rgba(12, 14, 18, 0.45), transparent); background-position: center center; background-size: cover; }

.hero::after { border-color: rgba(197, 160, 89, 0.25); box-shadow: rgba(197, 160, 89, 0.035) 0px 0px 0px 30px, rgba(197, 160, 89, 0.024) 0px 0px 0px 65px; }

.hero-inner { max-width: 900px; }

.eyebrow { font: 600 11px Cinzel, Georgia, serif; letter-spacing: 2.2px; color: rgb(197, 160, 89); }

.hero h1 { font: 800 clamp(38px, 6vw, 76px) / 1.12 Cinzel, Georgia, serif; letter-spacing: 1px; color: rgb(247, 248, 250); }

.hero h1 span { font-size: clamp(23px, 3.3vw, 42px); font-style: normal; background: linear-gradient(120deg, rgb(255, 255, 255) 15%, rgb(230, 197, 117) 90%) text; -webkit-text-fill-color: transparent; }

.hero p { font: 400 clamp(14px, 1.6vw, 18px) / 1.8 "Plus Jakarta Sans", Arial, sans-serif; color: rgb(216, 221, 230); max-width: 760px; }

.actions { gap: 14px; }

.btn { border-radius: 6px; background: linear-gradient(135deg, rgb(197, 160, 89), rgb(126, 99, 46)); border: 1px solid rgb(197, 160, 89); color: rgb(12, 14, 18); font: 700 11px Cinzel, Georgia, serif; letter-spacing: 1px; padding: 14px 22px; }

.btn:hover { background: linear-gradient(135deg, rgb(230, 197, 117), rgb(197, 160, 89)); transform: translateY(-2px); }

.btn.outline { background: rgba(12, 14, 18, 0.6); border-color: var(--fv-border); color: rgb(247, 248, 250); }

