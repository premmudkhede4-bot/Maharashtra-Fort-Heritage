------MultipartBoundary--BXk8KAuSM1FtTumBa8tFvNf2psfd3WeDlToXv4reOo----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-0bdd2027-4df8-4892-983c-fdaafecaa799@mhtml.blink

@charset "utf-8";

:root { --px-bg: #f4efe3; --px-card: #fffdf7; --px-ink: #172b25; --px-muted: #68766d; --px-line: #e5dece; --px-green: #24483a; --px-gold: #d7a94b; }

body.px-dark { --px-bg: #111d19; --px-card: #1b2b24; --px-ink: #edf0e8; --px-muted: #b3c0b5; --px-line: #34483d; --sand: #111d19; --paper: #1b2b24; --ink: #edf0e8; --muted: #b3c0b5; --line: #34483d; background: var(--px-bg); color: var(--px-ink); }

body.px-dark .fort-card, body.px-dark .modal-box, body.px-dark .px-panel, body.px-dark .px-feature-card { background: var(--px-card); color: var(--px-ink); border-color: var(--px-line); }

body.px-dark .fort-card p, body.px-dark .px-muted, body.px-dark .place { color: var(--px-muted); }

body.px-dark input, body.px-dark select, body.px-dark textarea { background: rgb(33, 53, 43); color: var(--px-ink); border-color: var(--px-line); }

.px-tools { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }

.px-nav-tools { flex-wrap: nowrap; gap: 7px; margin-left: 12px; flex-shrink: 0; }

.px-nav-tools .px-toolbtn { padding: 8px 12px; font-size: 12px; white-space: nowrap; }

.px-nav-tools .px-lang { padding: 7px 9px; font: 12px Arial; max-width: 112px; }

@media (max-width: 1100px) {
  nav { gap: 10px; padding-left: 4%; padding-right: 4%; }
  .px-nav-addon { gap: 7px; }
  .px-nav-addon a { font-size: 10px !important; }
}

@media (max-width: 800px) {
  nav { height: auto; min-height: 66px; flex-wrap: wrap; padding-top: 8px; padding-bottom: 8px; }
  .px-nav-tools { margin-left: auto; }
  .px-nav-addon { order: 3; width: 100%; justify-content: center; padding: 3px 0px; }
}

@media (max-width: 560px) {
  nav { height: auto; min-height: 62px; gap: 6px; }
  .brand { font-size: 14px; }
  .px-nav-tools { gap: 5px; margin-left: auto; }
  .px-nav-tools .px-toolbtn { padding: 7px 9px; font-size: 11px; }
  .px-nav-tools .px-lang { max-width: 92px; padding: 6px 7px; }
  .px-nav-addon { display: none; }
}

.px-toolbtn, .px-btn { border: 1px solid var(--px-gold); background: var(--px-green); color: white; border-radius: 999px; padding: 10px 15px; cursor: pointer; font: 600 13px Arial; transition: 0.2s; }

.px-toolbtn:hover, .px-btn:hover { transform: translateY(-2px); filter: brightness(1.12); }

.px-toolbtn.alt, .px-btn.alt { background: transparent; color: inherit; border-color: var(--px-line); }

.px-lang { padding: 9px 12px; border-radius: 999px; border: 1px solid var(--px-gold); background: rgb(255, 253, 247); color: rgb(23, 43, 37); }

.px-section { padding: 76px 8%; background: var(--px-bg); color: var(--px-ink); }

.px-section:nth-of-type(2n) { background: color-mix(in srgb,var(--px-bg) 90%,var(--px-gold) 10%); }

.px-heading { max-width: 760px; margin: 0px auto 30px; text-align: center; }

.px-heading .kicker { font: 700 11px Arial; letter-spacing: 2px; text-transform: uppercase; color: rgb(164, 122, 45); }

.px-heading h2 { font-size: clamp(29px, 4vw, 43px); margin: 10px 0px; }

.px-heading p, .px-muted { color: var(--px-muted); font: 14px / 1.75 Arial; }

.px-grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 18px; }

.px-panel, .px-feature-card { background: var(--px-card); border: 1px solid var(--px-line); border-radius: 18px; padding: 22px; box-shadow: rgba(24, 45, 32, 0.063) 0px 12px 32px; min-width: 0px; }

.px-panel h3, .px-feature-card h3 { margin: 0px 0px 10px; font-size: 22px; }

.px-panel p { font: 14px / 1.65 Arial; color: var(--px-muted); }

#fortMap { height: 440px; border-radius: 14px; z-index: 1; border: 1px solid var(--px-line); }

.px-map-legend { display: flex; gap: 14px; flex-wrap: wrap; font: 12px Arial; color: var(--px-muted); margin: 12px 0px; }

.px-map-legend span::before { content: "â—"; color: rgb(183, 134, 50); margin-right: 6px; }

.px-formrow { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 12px; }

.px-field { display: flex; flex-direction: column; gap: 6px; margin: 10px 0px; font: 13px Arial; }

.px-field input, .px-field select { width: 100%; padding: 12px; border: 1px solid var(--px-line); border-radius: 10px; background: var(--px-card); color: var(--px-ink); }

.px-result { background: color-mix(in srgb,var(--px-gold) 13%,var(--px-card)); border: 1px solid var(--px-line); padding: 15px; border-radius: 12px; margin-top: 14px; font: 14px / 1.6 Arial; }

.px-fortlist { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: 14px; }

.px-mini { border: 1px solid var(--px-line); border-radius: 14px; padding: 15px; background: var(--px-card); display: flex; flex-direction: column; gap: 7px; }

.px-mini strong { font-size: 16px; }

.px-mini small { color: var(--px-muted); font: 12px Arial; }

.px-heart { border: 0px; background: transparent; color: rgb(183, 134, 50); font-size: 22px; cursor: pointer; align-self: flex-end; }

.px-audio-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 15px; }

.px-quiz-q { border-top: 1px solid var(--px-line); padding: 16px 0px; }

.px-quiz-q p { font: 600 15px / 1.5 Arial; color: var(--px-ink); }

.px-option { display: block; width: 100%; text-align: left; margin: 7px 0px; padding: 12px; border: 1px solid var(--px-line); border-radius: 10px; background: transparent; color: var(--px-ink); cursor: pointer; font: 14px Arial; }

.px-option:hover { border-color: var(--px-gold); background: rgba(215, 169, 75, 0.094); }

.px-option.selected { border-color: var(--px-gold); background: rgba(215, 169, 75, 0.145); }

.px-option:disabled { cursor: default; opacity: 0.85; }

.px-progress { height: 7px; background: var(--px-line); border-radius: 10px; overflow: hidden; margin: 12px 0px; }

.px-progress span { display: block; height: 100%; background: var(--px-gold); width: 0px; transition: 0.25s; }

.px-fav-empty { padding: 22px; border: 1px dashed var(--px-line); border-radius: 12px; color: var(--px-muted); font: 14px Arial; }

.px-note { font: 12px / 1.6 Arial; color: var(--px-muted); margin-top: 10px; }

.px-nav-addon { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

.px-nav-addon button { font: 12px Arial; }

.px-section a { color: inherit; }

@media (max-width: 800px) {
  .px-grid { grid-template-columns: 1fr; }
  .px-fortlist { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
  .px-section { padding: 55px 5%; }
  #fortMap { height: 360px; }
  .px-nav-addon { justify-content: center; }
}

@media (max-width: 560px) {
  .px-fortlist, .px-formrow { grid-template-columns: 1fr; }
  .px-section { padding: 44px 5%; }
  #fortMap { height: 320px; }
  .px-panel { padding: 16px; }
  .px-tools { width: 100%; justify-content: center; }
}
